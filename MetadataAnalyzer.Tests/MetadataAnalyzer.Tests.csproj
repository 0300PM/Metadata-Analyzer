<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>MetadataAnalyzer.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MetadataAnalyzer.Core\MetadataAnalyzer.Core.csproj" />
    <ProjectReference Include="..\MetadataAnalyzer.Infrastructure\MetadataAnalyzer.Infrastructure.csproj" />
    <ProjectReference Include="..\MetadataAnalyzer.WPF\MetadataAnalyzer.WPF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Fixtures/**/*.cs" />
    <None Include="Fixtures\SampleAssembly\bin\$(Configuration)\net10.0\SampleAssembly.dll" Link="SampleAssembly.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>



</Project>
