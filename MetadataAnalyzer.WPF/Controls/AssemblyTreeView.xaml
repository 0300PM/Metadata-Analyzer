<UserControl x:Class="MetadataAnalyzer.WPF.Controls.AssemblyTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:MetadataAnalyzer.WPF.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
             d:DesignHeight="420"
             d:DesignWidth="320">

    <Grid>
        <TreeView x:Name="Tree"
                  ItemsSource="{Binding Assembly.Nodes}"
                  ItemContainerStyle="{StaticResource AssemblyTreeViewItemStyle}"
                  ItemTemplate="{StaticResource NodeHeaderTemplate}"
                  Style="{StaticResource AssemblyTreeViewStyle}"
                  AutomationProperties.AutomationId="AssemblyExplorer"
                  Visibility="{Binding CanUseTree, Converter={StaticResource BoolToVisibility}}"
                  SelectedItemChanged="OnSelectedItemChanged" />

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="260"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="No assembly loaded"
                       HorizontalAlignment="Center"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="Use File → Open Assembly or the Open button to load the sample assembly."
                       Margin="0,6,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Style="{StaticResource MutedStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
