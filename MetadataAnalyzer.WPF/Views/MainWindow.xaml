<Window x:Class="MetadataAnalyzer.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MetadataAnalyzer.WPF.Controls"
        xmlns:viewModels="clr-namespace:MetadataAnalyzer.WPF.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
        Title="{Binding Title}"
        Height="820"
        Width="1320"
        MinHeight="520"
        MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Assembly..." InputGestureText="Ctrl+O" Command="{Binding OpenAssemblyCommand}" />
                <MenuItem Header="_Close Assembly" Command="{Binding CloseAssemblyCommand}" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4"
                          Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Expand All" Command="{Binding ExpandAllCommand}" />
                <MenuItem Header="_Collapse All" Command="{Binding CollapseAllCommand}" />
                <Separator />
                <MenuItem Header="Show/Hide _Details Panel" Command="{Binding ToggleDetailsCommand}" />
                <Separator />
                <MenuItem Header="Log _Viewer" Command="{Binding ShowLogViewerCommand}" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Settings..." Command="{Binding ShowSettingsCommand}" />
                <MenuItem Header="_Clear Logs" Command="{Binding ClearLogsCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding ShowAboutCommand}" />
                <MenuItem Header="Application _Information" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1"
                Background="{StaticResource ToolbarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,1"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding OpenAssemblyCommand}"
                            ToolTip="Open assembly (load sample data)"
                            AutomationProperties.AutomationId="OpenAssembly">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Open" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="6,0,0,0"
                            Command="{Binding RefreshCommand}"
                            AutomationProperties.AutomationId="Refresh"
                            ToolTip="Reload metadata"
                            IsEnabled="{Binding HasMetadata}">
                        <TextBlock Text="Refresh" />
                    </Button>

                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="8,2" />

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding ExpandAllCommand}"
                            AutomationProperties.AutomationId="ExpandAll"
                            ToolTip="Expand all"
                            IsEnabled="{Binding CanUseTree}">
                        <TextBlock Text="Expand All" />
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding CollapseAllCommand}"
                            AutomationProperties.AutomationId="CollapseAll"
                            ToolTip="Collapse all"
                            IsEnabled="{Binding CanUseTree}">
                        <TextBlock Text="Collapse All" />
                    </Button>

                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="8,2" />

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding ShowSettingsCommand}"
                            ToolTip="Settings"
                            AutomationProperties.AutomationId="SettingsButton">
                        <TextBlock Text="Settings" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Subtitle}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="#FFFDF6E3"
                BorderBrush="#FFF1E1A8"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource WarningBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="View log"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding ShowLogViewerCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumn" Width="360" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}" CornerRadius="6,6,0,0">
                        <Grid>
                            <TextBlock Text="ASSEMBLY EXPLORER" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Assembly.FileName}"
                                       HorizontalAlignment="Right"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <controls:AssemblyTreeView Grid.Row="1" Margin="4,4,2,4" SelectedNode="{Binding SelectedNode}" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource SplitterStyle}" />

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding IsDetailsVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}" CornerRadius="6,6,0,0">
                        <Grid>
                            <TextBlock Text="DETAILS" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectionSummary}"
                                       HorizontalAlignment="Right"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <controls:DetailsPanel Grid.Row="1" DataContext="{Binding Details}" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="{StaticResource PanelHeaderBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasMetadata}" Value="False">
                                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Style="{StaticResource CaptionStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding Counters}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="12,2" />
                    <TextBlock Text="{Binding Stage}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
