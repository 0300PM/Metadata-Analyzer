<Window x:Class="MetadataAnalyzer.WPF.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:MetadataAnalyzer.WPF.ViewModels"
        xmlns:logging="clr-namespace:MetadataAnalyzer.Infrastructure.Logging;assembly=MetadataAnalyzer.Infrastructure"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:LogViewerViewModel}"
        Title="Log Viewer"
        Height="560"
        Width="900"
        MinHeight="320"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource WindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ToolbarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Level" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Style="{StaticResource InputComboBoxStyle}"
                          ItemsSource="{Binding Levels}"
                          SelectedItem="{Binding LevelFilter}"
                          MinWidth="140" />
                <CheckBox Style="{StaticResource InputCheckBoxStyle}"
                          Content="Auto-scroll"
                          IsChecked="{Binding AutoScroll}"
                          Margin="16,0,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource PanelHeaderBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Level" Style="{StaticResource SectionTitleStyle}" Width="110" />
                <TextBlock Grid.Column="1" Text="Message" Style="{StaticResource SectionTitleStyle}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}" Padding="4,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type logging:LogEntry}">
                        <Border Padding="8,3" CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Time}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Level}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Message}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3"
                Background="{StaticResource PanelHeaderBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Counters}" Style="{StaticResource MutedStyle}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearCommand}" />
                    <Button Content="Close" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Click="OnCloseClick" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
