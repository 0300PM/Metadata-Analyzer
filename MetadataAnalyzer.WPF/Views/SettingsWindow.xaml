<Window x:Class="MetadataAnalyzer.WPF.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:MetadataAnalyzer.WPF.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}"
        Title="Settings"
        Width="580"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource WindowStyle}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Logging" Style="{StaticResource SectionTitleStyle}" />
            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,6,0,12" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Log file path" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1"
                     Style="{StaticResource InputTextBoxStyle}"
                     Text="{Binding LogFilePath, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="LogFilePath" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding LogFileDescription}"
                       Style="{StaticResource MutedStyle}"
                       Margin="0,4,0,12" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Minimum level" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="2" Grid.Column="1"
                      HorizontalAlignment="Left"
                      Style="{StaticResource InputComboBoxStyle}"
                      ItemsSource="{Binding LogLevels}"
                      SelectedItem="{Binding LogLevel}"
                      AutomationProperties.AutomationId="LogLevel" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock Text="Application" Style="{StaticResource SectionTitleStyle}" />
            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,6,0,12" />

            <CheckBox Style="{StaticResource InputCheckBoxStyle}"
                      IsChecked="{Binding UseMockData}"
                      Content="Use sample (mock) metadata provider"
                      Margin="0,0,0,10" />

            <CheckBox Style="{StaticResource InputCheckBoxStyle}"
                      IsChecked="{Binding ShowDetailsPanel}"
                      Content="Show details panel in main window" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Margin="0,16,0,0"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage.Length}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding CancelCommand}" />
            <Button Content="Save"
                    Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.AutomationId="SaveSettings" />
        </StackPanel>
    </Grid>
</Window>
